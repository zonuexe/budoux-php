{
    "name": "zonuexe/budoux",
    "description": "A small, standalone, and language-neutral line break organizer.",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "reliforp/reli-prof": "^0.12.0"
    },
    "suggest": {
        "ext-dom": "Required for HTMLProcessor and Parser::translateHTMLString()"
    },
    "autoload": {
        "psr-4": {
            "Budoux\\": "php"
        }
    },
    "config": {
        "sort-packages": true
    }
}
